generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String       @id @default(uuid())
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  settings     TenantSettings?
  users        User[]
  customers    Customer[]
  staff        Staff[]
  categories   ServiceCategory[]
  services     Service[]
  appointments Appointment[]
  invoices     Invoice[]
  roles          Role[]
  pricing        Pricing[]
  staffSchedules StaffSchedule[]
  staffBreaks    StaffBreak[]
  staffLeaves    StaffLeave[]
  inventoryProducts InventoryProduct[]
  businessHours     TenantBusinessHour[]
  subscription      TenantSubscription?
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  timezone String @default("UTC")
  currency String @default("INR")

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model TenantBusinessHour {
  id        String   @id @default(uuid())
  tenantId  String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openTime  String   @default("09:00")
  closeTime String   @default("21:00")
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model User {
  id           String     @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  roles         UserRole[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
}

model Role {
  id       String @id @default(uuid())
  tenantId String
  name     String

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
}

model Feature {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  category    String   @default("Core Operations")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  plans       PlanFeature[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  featureId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  feature Feature?        @relation(fields: [featureId], references: [id], onDelete: Cascade)
  roles   RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PlanFeature {
  planId    String
  featureId String

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
}


model Customer {
  id        String          @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  notes     String?
  dob       DateTime?
  gender    Gender?
  status    CustomerStatus  @default(ACTIVE)
  isVip     Boolean         @default(false)
  source    CustomerSource  @default(WALK_IN)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  appointments  Appointment[]
  invoices      Invoice[]
  customerNotes CustomerNote[]
}

model CustomerNote {
  id         String @id @default(uuid())
  customerId String
  note       String

  customer Customer @relation(fields: [customerId], references: [id])
}

model Staff {
  id        String      @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime    @default(now())

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  appointments Appointment[]
  schedules    StaffSchedule[]
  breaks       StaffBreak[]
  leaves       StaffLeave[]
  services     StaffService[]
}

model StaffSchedule {
  id        String   @id @default(uuid())
  tenantId  String
  staffId   String
  dayOfWeek Int
  startTime String
  endTime   String
  isWorking Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@unique([staffId, dayOfWeek])
  @@index([tenantId, staffId])
}

model StaffBreak {
  id        String   @id @default(uuid())
  tenantId  String
  staffId   String
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@index([tenantId, staffId])
}

model StaffLeave {
  id        String   @id @default(uuid())
  tenantId  String
  staffId   String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@index([tenantId, staffId, startAt, endAt])
}

model ServiceCategory {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  services  Service[]
}

model Service {
  id              String        @id @default(uuid())
  tenantId        String
  categoryId      String
  name            String
  durationMinutes Int
  price           Float
  tax             Float?        @default(0)
  status          ServiceStatus @default(ACTIVE)
  commissionRule  String?

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])

  staff    StaffService[]
  pricing  Pricing[]

  appointmentItems AppointmentItem[]
  appointments     Appointment[]
}

model StaffService {
  staffId   String
  serviceId String

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([staffId])
  @@index([serviceId])
}

model Pricing {
  id        String   @id @default(uuid())
  tenantId  String
  serviceId String
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
}

model Appointment {
  id                 String            @id @default(uuid())
  tenantId           String
  customerId         String
  staffId            String
  serviceId          String

  appointmentDate    DateTime
  startAt            DateTime
  endAt              DateTime

  status             AppointmentStatus @default(PENDING)
  source             AppointmentSource @default(ADMIN)

  serviceName        String
  durationMinutes    Int
  price              Decimal

  customerNotes      String?
  internalNotes      String?
  cancellationReason String?

  createdBy          String?
  cancelledBy        String?
  cancelledAt        DateTime?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  customer Customer              @relation(fields: [customerId], references: [id])
  staff    Staff                 @relation(fields: [staffId], references: [id])
  service  Service               @relation(fields: [serviceId], references: [id])
  items    AppointmentItem[]
  timeline AppointmentTimeline[]
  invoice  Invoice?

  @@index([tenantId, appointmentDate])
  @@index([tenantId, staffId, startAt])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
}

model AppointmentItem {
  id            String @id @default(uuid())
  tenantId      String
  appointmentId String
  serviceId     String

  serviceName     String
  price           Decimal
  durationMinutes Int

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])
}

model AppointmentTimeline {
  id            String            @id @default(uuid())
  appointmentId String
  status        AppointmentStatus
  createdAt     DateTime          @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  appointmentId String?       @unique
  customerId    String
  status        InvoiceStatus @default(PENDING)
  totalAmount   Decimal
  createdAt     DateTime      @default(now())

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  appointment Appointment?  @relation(fields: [appointmentId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Decimal

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id                String        @id @default(uuid())
  invoiceId         String
  amount            Decimal
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  paidAt            DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum ServiceStatus {
  ACTIVE
  ARCHIVED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  CUSTOMER
  RECEPTIONIST
  ADMIN
  WALK_IN
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  NET_BANKING
  RAZORPAY
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CustomerSource {
  WALK_IN
  ONLINE
  REFERRAL
}

model InventoryProduct {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  sku           String
  category      String
  categoryBg    String?
  categoryColor String?
  brand         String?
  stock         Int      @default(0)
  unit          String?
  price         String?
  status        String   @default("In Stock")
  image         String?
  reorderLevel  Int      @default(0)
  purchasePrice String?
  sellingPrice  String?
  barcode       String?
  expiryDate    String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELED
}

model SubscriptionPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  code            String   @unique @default("STARTER")
  description     String?
  monthlyPrice    Float
  yearlyPrice     Float
  maxOutlets      Int      @default(1)
  maxStaff        Int      @default(5)
  enableInventory Boolean  @default(false)
  enableReports   Boolean  @default(false)
  enableMarketing Boolean  @default(false)
  enableWhatsApp  Boolean  @default(false)
  allowedModules  String[] @default(["APPOINTMENTS", "CUSTOMERS", "CATALOG", "STAFF", "BILLING"])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions TenantSubscription[]
  features      PlanFeature[]
}


model TenantSubscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  customAllowedModules String[]
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
}

model AuditLog {
  id             String   @id @default(uuid())
  actorUserId    String
  action         String
  targetTenantId String?
  reason         String?
  details        String?
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([actorUserId])
  @@index([targetTenantId])
}
